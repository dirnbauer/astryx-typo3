# root = false, so the project's own root .editorconfig still applies above
# this directory.
root = false

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 80

[*.rst]
indent_size = 4

[*.{yaml,yml}]
indent_size = 2

[*.xml]
indent_size = 4
