<?xml version="1.0" encoding="UTF-8"?>
<!--
    TYPO3 documentation rendering configuration.

    The namespace is phpDocumentor's, not TYPO3's: rendering is done by
    phpDocumentor Guides, and a file declaring anything else is well-formed
    XML that renders nothing.
-->
<guides xmlns="https://www.phpdoc.org/guides"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://www.phpdoc.org/guides vendor/phpdocumentor/guides-cli/resources/schema/guides.xsd"
        links-are-relative="true"
        default-code-language="php"
>
    <extension class="\T3Docs\Typo3DocsTheme\DependencyInjection\Typo3DocsThemeExtension"
               project-home="https://github.com/dirnbauer/astryx-typo3"
               project-repository="https://github.com/dirnbauer/astryx-typo3"
               project-issues="https://github.com/dirnbauer/astryx-typo3/issues"
               edit-on-github="dirnbauer/astryx-typo3"
               edit-on-github-branch="main"
               typo3-core-preferred="14.3"
               interlink-shortcode="astryx_typo3"
    />
    <project title="Astryx for TYPO3"
             version="2.1"
             release="2.1.1"
             copyright="2026 by webconsulting studio"/>
</guides>
