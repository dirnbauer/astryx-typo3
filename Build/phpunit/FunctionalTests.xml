<?xml version="1.0" encoding="UTF-8"?>
<!--
    Functional test suite. Run: composer test:functional

    Shaped after typo3/testing-framework's own
    Resources/Core/Build/FunctionalTests.xml, with the bootstrap copied into
    Build/FunctionalTestsBootstrap.php as the framework asks extensions to do.

    Database: sqlite by default, so `composer test:functional` needs nothing
    installed but PHP's pdo_sqlite. PHPUnit's <env> only sets a variable that is
    not already in the environment (that is what the absent force="true" means),
    so CI can select MariaDB simply by exporting typo3DatabaseDriver=mysqli plus
    typo3DatabaseName/Host/Username/Password — those win over the values here.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         backupGlobals="true"
         bootstrap="../FunctionalTestsBootstrap.php"
         cacheDirectory="../../var/phpunit/functional"
         cacheResult="false"
         colors="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         failOnRisky="true"
         failOnWarning="true"
         requireCoverageMetadata="false"
>
    <testsuites>
        <testsuite name="Functional tests">
            <directory>../../Tests/Functional/</directory>
        </testsuite>
    </testsuites>

    <php>
        <ini name="display_errors" value="1"/>
        <env name="TYPO3_CONTEXT" value="Testing"/>
        <env name="typo3DatabaseDriver" value="pdo_sqlite"/>
    </php>

    <!--
        Only this extension's own code may turn the suite red with a
        deprecation or notice. Booting TYPO3 14.3 together with Content Blocks,
        Visual Editor and Desiderio emits deprecations from those packages that
        cannot be fixed here.
    -->
    <source ignoreIndirectDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>../../Classes</directory>
        </include>
    </source>
</phpunit>
