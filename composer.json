{
    "name": "webconsulting/astryx-typo3",
    "type": "typo3-cms-extension",
    "description": "Astryx for TYPO3 — the Astryx design system, server-rendered for TYPO3 14: 250 Content Blocks, 89 Fluid components, 25 runtime-switchable themes, no JavaScript framework",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "webconsulting studio"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/desiderio.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-visual-editor-enhancements.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "friendsoftypo3/content-blocks": "^2.2",
        "praetorius/vite-asset-collector": "^1.18",
        "typo3/cms-core": "^14.3.7",
        "typo3/cms-fluid": "^14.3.7",
        "webconsulting/desiderio": "^4.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2",
        "phpstan/phpstan-phpunit": "^2",
        "phpunit/phpunit": "^11.5",
        "saschaegerer/phpstan-typo3": "^3.1",
        "symfony/yaml": "^7.3 || ^8.0",
        "typo3/coding-standards": "^0.8 || ^0.9",
        "typo3/testing-framework": "^9.5"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "friendsoftypo3/visual-editor": "Optional. Inline visual editing and the element library plus-button. Thank you to the friends of TYPO3 maintainers."
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\AstryxTypo3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\AstryxTypo3\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "astryx_typo3",
            "web-dir": "public"
        }
    },
    "scripts": {
        "lint": "find Classes Tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "cgl": "php-cs-fixer fix --diff",
        "cgl:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "@php -d memory_limit=-1 vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "test:unit": "@php -d memory_limit=-1 vendor/bin/phpunit --configuration=Build/phpunit/UnitTests.xml",
        "test:functional": "@php -d memory_limit=-1 vendor/bin/phpunit --configuration=Build/phpunit/FunctionalTests.xml",
        "test": [
            "@test:unit",
            "@test:functional"
        ],
        "audit-elements": "@php -d memory_limit=-1 vendor/bin/phpunit --configuration=Build/phpunit/UnitTests.xml --filter ContentElementAuditTest"
    },
    "scripts-descriptions": {
        "lint": "Syntax-check every PHP file in Classes/ and Tests/.",
        "cgl": "Apply the TYPO3 coding standards in place.",
        "cgl:check": "Report coding standard violations without changing files.",
        "phpstan": "Run static analysis at level 8.",
        "test:unit": "Run the unit test suite.",
        "test:functional": "Run the functional test suite (sqlite by default).",
        "test": "Run unit and functional tests.",
        "audit-elements": "Run the content element catalog audit."
    }
}
