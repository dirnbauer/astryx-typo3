{
    "name": "webconsulting/astryx-typo3",
    "type": "typo3-cms-extension",
    "description": "Astryx for TYPO3 — the Astryx design system, server-rendered for TYPO3 14: 250 Content Blocks, seven runtime-switchable themes, no JavaScript framework",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "webconsulting studio"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/desiderio.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/dirnbauer/typo3-visual-editor-enhancements.git"
        }
    ],
    "require": {
        "php": "^8.4",
        "friendsoftypo3/content-blocks": "^2.2",
        "praetorius/vite-asset-collector": "^1.18",
        "typo3/cms-core": "^14.3",
        "typo3/cms-fluid": "^14.3",
        "webconsulting/desiderio": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "^7.3 || ^8.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "friendsoftypo3/visual-editor": "Optional. Inline visual editing and the element library plus-button. Thank you to the friends of TYPO3 maintainers."
    },
    "autoload": {
        "psr-4": {
            "Webconsulting\\AstryxTypo3\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webconsulting\\AstryxTypo3\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "astryx_typo3",
            "web-dir": "public"
        }
    },
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml.dist",
        "audit-elements": "php scripts/audit-content-elements.php"
    }
}
