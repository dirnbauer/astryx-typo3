{
  "name": "@webconsulting/astryx-typo3",
  "private": true,
  "version": "2.6.1",
  "description": "Build tooling for the Astryx for TYPO3 TYPO3 extension: Astryx theme tokens, component CSS, self-hosted fonts.",
  "type": "module",
  "scripts": {
    "build": "npm run build:contract && npm run build:themes && npm run build:theme && npm run build:contrast && npm run build:css && npm run build:fonts && npm run build:overview && npm run audit:contrast",
    "build:theme": "node Build/Scripts/build-astryx-theme.mjs",
    "build:contrast": "node Build/Scripts/build-contrast-overrides.mjs",
    "build:css": "node Build/Scripts/build-astryx-css.mjs",
    "build:fonts": "node Build/Scripts/sync-fonts.mjs",
    "audit:contrast": "node Build/Scripts/audit-contrast.mjs",
    "review:install": "PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-var/playwright} playwright install chromium",
    "review": "npm run review:install && PLAYWRIGHT_BROWSERS_PATH=${PLAYWRIGHT_BROWSERS_PATH:-var/playwright} node Build/Scripts/design-review.mjs --harness",
    "upstream:fetch": "node Build/Scripts/fetch-astryx-manifest.mjs",
    "upstream:diff": "node Build/Scripts/diff-astryx-manifest.mjs",
    "build:themes": "node Build/Scripts/build-astryx-themes.mjs",
    "build:overview": "node Build/Scripts/build-theme-overview.mjs",
    "build:contract": "node Build/Scripts/sync-component-contract.mjs",
    "check:upstream": "node Build/Scripts/check-astryx-upstream.mjs",
    "test:browser:upstream": "node Tests/Browser/upstream-073.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/albert-sans": "^5.3.0",
    "@fontsource/fustat": "^5.3.0",
    "@fontsource/playwrite-us-trad": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.1"
  },
  "packageManager": "npm@12.2.1"
}
